# ==========================================
# SentinelEdge Environment Variables
# ==========================================

# --- Backend (FastAPI / Render) ---
DATABASE_URL=sqlite:///./sentineledge.db
CORRELATION_WINDOW_MINUTES=30
BRUTE_FORCE_THRESHOLD=5
DATA_EXFIL_THRESHOLD_MB=500

# CORS Allowed Origins (Comma-separated for custom origins in production)
CORS_ORIGINS=https://sentineledge.vercel.app,http://localhost:3000

# AI Provider Configuration ('local' | 'openai' | 'gemini' | 'anthropic')
AI_PROVIDER=local
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# --- Frontend (Next.js / Vercel) ---
# In development: http://localhost:8000/api/v1
# In production: https://sentineledge.onrender.com/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
